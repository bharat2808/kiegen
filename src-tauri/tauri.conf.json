{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiegen",
  "version": "0.1.0",
  "identifier": "com.kiegen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kiegen settings",
        "width": 780,
        "height": 640,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Speak any selected text, from anywhere",
    "longDescription": "kiegen lives in the menu bar. Select text in any app, press a shortcut, and hear it read aloud. Requires Accessibility permission to read the selection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}