{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiegen",
  "version": "0.1.2",
  "identifier": "com.kiegen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kiegen settings",
        "width": 780,
        "height": 640,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Bharat Bharat (BQVR37A9HG)",
      "hardenedRuntime": true
    },
    "category": "Productivity",
    "shortDescription": "Speak any selected text, from anywhere",
    "longDescription": "kiegen lives in the menu bar. Select text in any app, press a shortcut, and hear it read aloud. Requires Accessibility permission to read the selection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2Q0VFQjgyMzgzNjVDREEKUldUYVhEWTRndXZPaHRzV0pyNElhTFZ3VnR2QlhwRk1aN2xVanh3eGFZN3k2ZTM1UWpqUGM0LzQK",
      "endpoints": [
        "https://github.com/bharat2808/kiegen/releases/latest/download/latest.json"
      ]
    }
  }
}
